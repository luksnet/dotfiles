// Fastfetch w kolorach Gruvbox Material: logo Arch #458588, etykiety aqua.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "color": { "1": "38;2;69;133;136", "2": "38;2;69;133;136" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;137;180;130", "title": "38;2;216;166;87", "output": "38;2;212;190;152" },
    "key": { "width": 9 }
  },
  "modules": [
    "title",
    { "type": "os",       "key": "system" },
    { "type": "kernel",   "key": "jądro" },
    { "type": "uptime",   "key": "czas" },
    { "type": "packages", "key": "pakiety" },
    { "type": "de",       "key": "pulpit" },
    { "type": "cpu",      "key": "cpu" },
    { "type": "memory",   "key": "ram" },
    { "type": "disk",     "key": "dysk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
