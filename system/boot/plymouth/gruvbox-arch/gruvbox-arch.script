# Plymouth: tło #282828, logo Arch na środku, pasek postępu aqua pod spodem.
Window.SetBackgroundTopColor(0.157, 0.157, 0.157);
Window.SetBackgroundBottomColor(0.157, 0.157, 0.157);

W = Window.GetWidth();
H = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(W / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(H / 2 - logo.image.GetHeight() / 2 - 40);

bar_y = H / 2 + logo.image.GetHeight() / 2 + 30;
bg.image = Image("bar-bg.png");
bg.sprite = Sprite(bg.image);
bg.sprite.SetX(W / 2 - bg.image.GetWidth() / 2);
bg.sprite.SetY(bar_y);

bar.original = Image("bar.png");
bar.sprite = Sprite();
bar.sprite.SetX(W / 2 - bg.image.GetWidth() / 2);
bar.sprite.SetY(bar_y);
bar.sprite.SetZ(1);

fun progress_callback(duration, progress) {
    w = Math.Int(bar.original.GetWidth() * progress);
    if (w < 1) w = 1;
    bar.sprite.SetImage(bar.original.Scale(w, bar.original.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Komunikaty (np. przy wyłączaniu) małym tekstem pod paskiem
msg.sprite = Sprite();
fun message_callback(text) {
    msg.image = Image.Text(text, 0.66, 0.6, 0.52);
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetX(W / 2 - msg.image.GetWidth() / 2);
    msg.sprite.SetY(bar_y + 30);
}
Plymouth.SetMessageFunction(message_callback);
